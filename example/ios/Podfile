# Modern CDN trunk - resolves in seconds. The old git source
# (github.com/CocoaPods/Specs.git) forced a multi-GB clone.
source 'https://cdn.cocoapods.org/'

platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # Published on CocoaPods trunk. 1.5.1 IS published (podspec.json returns 200), but
  # the trunk version index (all_pods_versions_2_d_2.txt) still ends at 1.5.0, so plain
  # `pod 'VietmapTrackingSDK', '1.5.1'` cannot resolve. Pointing at the podspec URL
  # directly skips the index lookup and fetches only this one file - which also avoids
  # the bulk download that trips the HTTP2 error on --repo-update.
  # Once the index lists 1.5.1, this can go back to: pod 'VietmapTrackingSDK', '1.5.1'
  pod 'VietmapTrackingSDK',
      :podspec => 'https://cdn.cocoapods.org/Specs/2/d/2/VietmapTrackingSDK/1.5.1/VietmapTrackingSDK.podspec.json'

  # Local build - swap to this (and to the version-less s.dependency in the plugin
  # podspec) to consume VietmapTrackingSDK.xcframework built in place by
  # `bash build_xcframework.sh` in map-sdk-tracking/ios. Path is relative to this
  # Podfile, so it holds as long as both repos sit side by side under Vietmap_SDK/.
  # pod 'VietmapTrackingSDK', :path => '../../../map-sdk-tracking/ios'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
